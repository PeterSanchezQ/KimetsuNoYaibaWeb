<div class="char text-center mt-4">
    <div class="card">
        <% if (personaje) { %>

            <div class="card-front error-state">
                <h2>
                    <%= personaje.name %>
                </h2>
                <img id="imagen" src="<%= personaje.img %>" alt="<%= personaje.name %>" class="img-fluid">
            </div>

            <div class="card-back">
                <div class="Cinfo">
                    <p id="info">
                        Name: <%= personaje.name %><br>
                            Age: <%= personaje.age %> años <br>
                                Génder: <%= personaje.gender %><br>
                                    Type: <%= personaje.race %><br>
                                        Description: <%= personaje.description %>
                    </p>
                </div>
            </div>

            <% } else if (error) { %>
                <div class="card-front">
                    <h2>
                        <%= error %>
                    </h2>
                    <img id="imagen" src="/img/notfound.png" alt="No encontrado" class="img-fluid" style="margin: auto;">

                </div>
                <div class="card-back">
                    <div class="Cinfo">
                        <h2>
                            Ingresa a la lista de Personajes y confirma el nombre del personaje que mas te guste.
                        </h2>
                    </div>

                </div>
                <% } else { %>
                    <p>Busca un personaje para mostrar aquí.</p>
                    <% } %>
    </div>
</div>