<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Demon Slayer</title>
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/todos.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
    <%- include('navbar'); -%>

        <section class="lista">
                <% if (listaPersonajes && listaPersonajes.length> 0) { %>
                    <div class="card tjt">

                        <!-- Carrusel único -->
                        <div id="carouselExample" class="bdtr carousel slide">
                            <div class="tarjeta carousel-inner ">
                                <% listaPersonajes.forEach((personaje, index)=> { %>
                                    <div  class="carousel-item <%= index === 0 ? 'active' : '' %>">

                                        <div class="ImgChar">
                                            <img src="<%= personaje.img %>" alt="<%= personaje.name %>">
                                        </div>

                                        <div class="carousel-caption card-body datos">
                                            <h5 class="card-title ">
                                                <%= personaje.name %>
                                            </h5>
                                        </div>

                                    </div>
                                    <% }) %>
                            </div>
                            <!-- Controles (solo una vez) -->
                            <button class="carousel-control-prev btnPrev" type="button"
                                data-bs-target="#carouselExample" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Anterior</span>
                            </button>
                            <button class="carousel-control-next btnNxt" type="button" data-bs-target="#carouselExample"
                                data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Siguiente</span>
                            </button>
                        </div>
                    </div>
                    <% } else { %>
                        <p>No hay personajes disponibles.</p>
                        <% } %>
        </section>

        <!-- Paginación -->
        <section class="container text-center">
            <div class="control">
                <% if (page>= 1) { %>
                    <a href="/listaPersonajes/?page=<%= page -1 %>"
                        class="btn btn-danger <%= page === 1 ? 'disabled' : '' %>">Anterior</a>
                    <a href="/listaPersonajes/?page=<%= page +1 %>" class="btn btn-danger">Siguiente</a>
                    <% } %>
            </div>
        </section>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>
</body>

</html>